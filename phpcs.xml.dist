<?xml version="1.0"?>
<ruleset name="Tainacan Index Manager standards">
	<description>WPCS + Plugin Check + PHPCompatibility for Tainacan Index Manager.</description>

	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress.Security"/>
	<rule ref="PluginCheck"/>

	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_tainacan"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="TainacanIndexManager"/>
				<element value="TAINACAN_INDEX_MANAGER"/>
				<element value="tainacan_index_manager"/>
				<element value="tainacan_idxmgr"/>
				<element value="tim"/>
				<element value="TIM"/>
			</property>
		</properties>
	</rule>

	<arg name="extensions" value="php"/>
	<arg value="s"/>
	<file>.</file>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/assets/vendor/*</exclude-pattern>
	<exclude-pattern>*/tools/*</exclude-pattern>
	<exclude-pattern>*/docs/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
</ruleset>
